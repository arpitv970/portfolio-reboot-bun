---
import type { GetStaticPaths } from "astro";
import { getCollection, render } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import MarkdownContentLayout from "@/layouts/MarkdownContentLayout.astro";

export const getStaticPaths = (async () => {
  const blogs = await getCollection("blog");
  return blogs.map((blog) => ({
    params: { slug: blog.id },
    props: { blog },
  }));
}) satisfies GetStaticPaths;

const { blog } = Astro.props;
const { Content, remarkPluginFrontmatter } = await render(blog);
const { title, description, tags, coverImgSrc, publishedAt, author } = blog.data;
const { readingTime } = remarkPluginFrontmatter;
---

<BaseLayout title={title} description={description} image={coverImgSrc}>
  <MarkdownContentLayout 
    title={title}
    description={description}
    coverImgSrc={coverImgSrc}
    tags={tags}
    readingTime={readingTime}
    id={blog.id}
    Content={Content}
    publishedAt={publishedAt}
    author={author}
  />
</BaseLayout>