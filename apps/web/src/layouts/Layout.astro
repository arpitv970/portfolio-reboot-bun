<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{Astro.props.title || "Arpit Verma - Full Stack Developer"}</title>

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={Astro.url} />
		<meta property="og:title" content={Astro.props.title || "Arpit Verma - Full Stack Developer"} />
		<meta property="og:description" content={Astro.props.description || "Building scalable multi-tenant CRMs, ERPs & Dashboards with granular access controls"} />
		<meta property="og:image" content={Astro.props.ogImage || `${Astro.url.origin}/og/${Astro.url.pathname === '/' ? 'image' : Astro.url.pathname.slice(1)}.png`} />

		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content={Astro.url} />
		<meta property="twitter:title" content={Astro.props.title || "Arpit Verma - Full Stack Developer"} />
		<meta property="twitter:description" content={Astro.props.description || "Building scalable multi-tenant CRMs, ERPs & Dashboards with granular access controls"} />
		<meta property="twitter:image" content={Astro.props.ogImage || `${Astro.url.origin}/og/${Astro.url.pathname === '/' ? 'image' : Astro.url.pathname.slice(1)}.png`} />
	</head>
	<body>
		<slot />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
